# Production Environment
NODE_ID=node-0
NODE_HOST=0.0.0.0
NODE_PORT=8000
PEERS=node-1.dist-sys:8000,node-2.dist-sys:8000
USE_TLS=true
CERT_DIR=/app/certs
ETCD_ENDPOINTS=http://etcd-0.etcd:2379,http://etcd-1.etcd:2379,http://etcd-2.etcd:2379
METRICS_PORT=9090
MAX_WORKERS=4
MAX_QUEUE_DEPTH=500
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_TIMEOUT=8.0
GOSSIP_INTERVAL=2.0
FAILURE_TIMEOUT=15.0