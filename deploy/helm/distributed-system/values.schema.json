{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["replicaCount", "image", "service", "cluster", "etcd", "tls", "persistence", "resources"],
  "properties": {
    "replicaCount": {"type": "integer", "const": 3},
    "releaseMode": {"type": "boolean"},
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string"},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"enum": ["IfNotPresent", "Always", "Never"]}
      }
    },
    "service": {"type": "object"},
    "cluster": {"type": "object"},
    "etcd": {"type": "object", "required": ["endpoints"]},
    "tls": {"type": "object"},
    "persistence": {"type": "object"},
    "resources": {"type": "object"}
  }
}
