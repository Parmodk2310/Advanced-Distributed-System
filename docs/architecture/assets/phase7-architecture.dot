digraph Phase7 {
  graph [rankdir=LR, bgcolor="transparent", label="PHASE 7 — PLANNED — NOT IMPLEMENTED", labelloc=t, fontname="Arial Bold", fontsize=20, pad=0.3];
  node [shape=box, style="rounded,filled,dashed", fontname="Arial", color="#64748B", fillcolor="#F1F5F9"];
  edge [color="#64748B", penwidth=1.5, style=dashed];
  source [label="Source commit"];
  gates [label="Quality + security gates"];
  image [label="Immutable container image"];
  local [label="Local kind / k3d validation"];
  helm [label="Helm release contract"];
  registry [label="Registry digest promotion"];
  terraform [label="Terraform"];
  eks [label="AWS EKS"];
  rollout [label="Rollout verification\n+ rollback"];
  source -> gates -> image -> local -> helm -> registry -> terraform -> eks -> rollout;
}
